// B2BOX CARGO CUP - Prode del Mundial 2026
// Producción: Postgres (Neon / Vercel Postgres). DATABASE_URL en variables de entorno.
// Para correr 100% offline con SQLite, cambiar provider a "sqlite" y DATABASE_URL a "file:./dev.db".

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  username    String       @unique
  name        String
  token       String       @unique // link único de acceso (sin contraseña)
  color       String // color del contenedor (tema b2box)
  isAdmin     Boolean      @default(false)
  predictions Prediction[]
  createdAt   DateTime     @default(now())
}

model Match {
  id          String       @id @default(cuid())
  stage       String       @default("Fase de grupos") // Fase de grupos, Octavos, etc.
  group       String? // A, B, C...
  homeTeam    String
  homeFlag    String       @default("🏳️")
  awayTeam    String
  awayFlag    String       @default("🏳️")
  kickoff     DateTime
  // Resultado: "HOME" gana local, "AWAY" gana visitante, "DRAW" empate, null = sin jugar
  result      String?
  predictions Prediction[]
  createdAt   DateTime     @default(now())
}

// Clave-valor para estado interno (ej: última sincronización de resultados)
model Meta {
  key   String @id
  value String
}

model Prediction {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  // El equipo que el usuario eligió: "HOME" o "AWAY"
  pick      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchId])
}
